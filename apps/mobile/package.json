{
  "name": "@yahtzee/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": ["expo-file-system"]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform android --max-workers 2 --output-dir ../../reports/mobile/android && expo export --platform ios --max-workers 2 --output-dir ../../reports/mobile/ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.17",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@yahtzee/game-engine": "workspace:*",
    "expo": "57.0.31",
    "expo-asset": "57.0.20",
    "expo-build-properties": "57.0.22",
    "expo-constants": "57.0.22",
    "expo-file-system": "57.0.7",
    "expo-linking": "57.0.13",
    "expo-router": "57.0.29",
    "expo-splash-screen": "57.0.10",
    "expo-sqlite": "57.0.4",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "4.26.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "6.0.3",
    "@types/node": "^26.6.2"
  }
}
