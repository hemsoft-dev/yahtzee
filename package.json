{
  "name": "yahtzee",
  "version": "0.1.0",
  "private": true,
  "description": "Classic Yahtzee dice game with 5/6/N dice, multiplayer, and leaderboards \u2014 Electron desktop + Expo mobile + web",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "bun run --filter @yahtzee/web dev",
    "dev:desktop": "bun run --filter @yahtzee/desktop dev",
    "dev:mobile": "bun run --filter @yahtzee/mobile start",
    "dev:convex": "npx convex dev",
    "build:web": "bun run --filter @yahtzee/web build",
    "build:desktop": "bun run --filter @yahtzee/desktop build",
    "package:offline": "bun scripts/package-offline.ts",
    "test:offline": "node node_modules/playwright/cli.js test --config tests/offline/playwright.config.ts",
    "build:mobile": "bun run --filter @yahtzee/mobile build",
    "test": "bun run --filter @yahtzee/game-engine test",
    "test:watch": "bun run --filter @yahtzee/game-engine test --watch",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "bun run --filter \"*\" typecheck && tsc -p convex/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json && tsc -p tests/clients/tsconfig.json",
    "security": "bun scripts/security-audit.ts",
    "quality:measure": "bun scripts/quality/run.ts",
    "mutation": "bun scripts/mutation/run.ts",
    "mutation:probe": "bun scripts/mutation/probe.ts",
    "codegen:offline": "bun scripts/convex-api-offline.mjs",
    "test:clients": "bun run build:desktop && node node_modules/playwright/cli.js test",
    "test:clients:install": "node node_modules/playwright/cli.js install chromium && node apps/desktop/node_modules/electron/install.js"
  },
  "author": "Franz Hemmer <franz_hemmer@hotmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hemsoft-dev/yahtzee.git"
  },
  "dependencies": {
    "convex": "1.46.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@types/bun": "1.4.2",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/istanbul-lib-instrument": "1.7.8",
    "@types/node": "26",
    "@types/react": "19",
    "@types/react-dom": "19",
    "convex-test": "0.0.59",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.5.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "mutation-testing-metrics": "3.8.4",
    "mutation-testing-report-schema": "3.9.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-web": "0.21.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "braces": "3.0.3",
    "node-forge": "1.4.0",
    "sprintf-js": "1.1.3"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "^22.13.0 || >=24.3.0"
  },
  "overrides": {
    "decode-uri-component": "0.5.0",
    "qs": "6.16.0",
    "uuid": "11.1.1",
    "http-cache-semantics": "4.3.0",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "braces": "3.0.3",
    "node-forge": "1.4.0",
    "sprintf-js": "1.1.3"
  },
  "patchedDependencies": {
    "query-string@7.1.3": "patches/query-string@7.1.3.patch",
    "braces@3.0.3": "patches/braces@3.0.3.patch",
    "node-forge@1.4.0": "patches/node-forge@1.4.0.patch",
    "sprintf-js@1.1.3": "patches/sprintf-js@1.1.3.patch"
  }
}
